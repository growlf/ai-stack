# ─── ai-stack .env.example ────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running install.sh
# cp .env.example .env
#
# ── Bitwarden / VaultWarden Integration ───────────────────────────────────────
# This project supports <vaultwarden:path> placeholders in .env values.
# The install.sh script can set this up for you.
# Placeholder format: <vaultwarden:organization-id/item-name>
#   Examples:
#     <vaultwarden:ai-cluster/infra/anthropic-api>
#     <vaultwarden:ai-cluster/services/litellm>
#
# Requirements:
#   - Bitwarden CLI installed (npm install -g @bitwarden/cli)
#   - Vault unlocked, or BW_CLIENT_ID + BW_CLIENT_SECRET set
#
# For self-hosted VaultWarden, set:
# BW_SERVER_URL=https://vaultwarden.example.com
#
# To resolve manually: ./scripts/resolve-vaultwarden.sh

# ─── Host paths ───────────────────────────────────────────────────────────────
STACK_USER=yourusername
OLLAMA_DATA=/home/${STACK_USER}/.ollama

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
# Memory limits — adjust for your hardware.
# Intel Arc users: 16gb / 32g is a good starting point for a 32GB system.
# NVIDIA GPU users: match shm to your VRAM size.
# CPU-only users: 2gb / 8g (defaults set in docker-compose.yml).
OLLAMA_SHM_SIZE=2gb
OLLAMA_MEM_LIMIT=8g

# ── Intel Arc GPU device nodes (only needed with docker-compose.arc.yml) ──────
# Run scripts/check-arc-gpu.sh to find the correct device paths for your system.
# These values are ignored when using the CPU or NVIDIA compose overlay.
GPU_CARD=/dev/dri/card1
GPU_RENDER=/dev/dri/renderD128

# ── Cloud API Keys ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=  # optional — leave blank if not using OpenAI

# ── LiteLLM ───────────────────────────────────────────────────────────────────
LITELLM_PORT=4000
# Generate a secure key with: scripts/generate-keys.sh
LITELLM_MASTER_KEY=sk-change-this-before-deployment

# ── Olla — unified LLM router ─────────────────────────────────────────────────
OLLA_PORT=40114

# Additional Ollama nodes on your LAN.
# Format: OLLAMA_REMOTE_<NAME>=http://host:port[:priority]
# Examples:
#   OLLAMA_REMOTE_WORKSTATION=http://192.168.1.50:11434:75
#   OLLAMA_REMOTE_NAS_BOX=http://192.168.1.51:11434

# Advanced Olla tuning (optional — defaults shown)
# OLLA_ENGINE=sherpa
# OLLA_LOAD_BALANCER=least-connections
# OLLA_REQUEST_LOGGING=true

# ── Retriever — Obsidian vault RAG service ────────────────────────────────────
# Lightweight replacement for Khoj + PostgreSQL.
# Uses sqlite-vec (file-based), hybrid search (FTS5 + vector), watchdog live indexing.
# API-only: no web UI. Designed as an OpenCode tool.
RETRIEVER_PORT=42000
RETRIEVER_VAULT_PATH=/home/${STACK_USER}/obsidian
RETRIEVER_EMBED_MODEL=nomic-embed-text
RETRIEVER_CHUNK_SIZE=512
RETRIEVER_CHUNK_OVERLAP=64

# ─── Remote Ollama instances ──────────────────────────────────────────────────
# These are added to Olla's routing and can be discovered by discover-herd.sh.
# Examples:
# OLLAMA_REMOTE_frank=http://10.10.1.1:11434
# OLLAMA_REMOTE_lab1=http://10.10.1.2:11434

# ─── Models to pull after install ─────────────────────────────────────────────
# MODELS_TO_PULL="deepseek-r1:14b qwen2.5-coder:14b gemma3:12b qwen2.5:14b nomic-embed-text:latest"

# ─── Smart Router (40115) ─────────────────────────────────────────────────────
# Sits between OpenCode and Olla; classifies prompts and picks the best
# local model. Defaults work for most setups.
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=40115
# CLASSIFY_MODEL=qwen2.5:1.5b
# CAPABILITY_REFRESH_INTERVAL=300

# ─── Shepherd — herd observability ────────────────────────────────────────────
# Shepherd currently runs natively (via scripts/shepherd-auto-deploy.sh per peer);
# these env vars only apply to that pattern. When Shepherd is dockerized in a
# future enhancement, these will be defaulted by the compose file.
#
# shepherd-node (one per herd peer):
# SHEPHERD_NODE_NAME=cluster-llm        # display name on dashboard; defaults to hostname
# SHEPHERD_NODE_ADDRESS=100.123.141.125 # network address advertised to control
# SHEPHERD_NODE_HOST=0.0.0.0
# SHEPHERD_NODE_PORT=40118
#
# shepherd-control (typically one per herd, runs alongside shepherd-node):
# SHEPHERD_CONTROL_HOST=0.0.0.0
# SHEPHERD_CONTROL_PORT=40117
# SHEPHERD_CONTROL_NAME=cluster-llm     # control host's display name
# SHEPHERD_PEERS=cluster-llm=http://localhost:40118,lab2=http://10.10.0.212:40118
# SHEPHERD_POLL_INTERVAL=5
#
# Layer 3.5 auto-recovery:
# SHEPHERD_AUTO_RECOVERY=1              # 0 to disable docker-restart on divergence
# SHEPHERD_OLLAMA_CONTAINER=ollama      # container to restart on divergence
#
# Layer 4 baseline-check (latency-regression detection):
# SHEPHERD_BASELINE_INTERVAL=300        # seconds between synthetic-prompt baseline checks (default 5min)
#
# Olla federation views shepherd-control queries:
# OLLA_URLS=http://localhost:40114,http://other-host:40114
#
# Shepherd-node's local Ollama reference (when not running in compose):
# OLLAMA_URL=http://localhost:11434
#
# Optional logging:
# SHEPHERD_LOG_LEVEL=info
