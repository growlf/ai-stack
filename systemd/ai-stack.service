[Unit]
Description=AI Stack (Ollama + LiteLLM + Olla + Router + Retriever + Apostle)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=${INSTALL_DIR}
# Use start.sh to resolve VaultWarden placeholders before starting
ExecStart=/usr/bin/bash ${INSTALL_DIR}/start.sh -d
ExecStop=/usr/bin/docker compose down
User=${STACK_USER}
Group=docker

[Install]
WantedBy=multi-user.target
