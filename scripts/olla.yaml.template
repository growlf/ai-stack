# olla.yaml.template
#
# This is the TEMPLATE checked into the repo.
# The actual proxy/olla.yaml (with your LAN node addresses) is generated by
# scripts/generate-olla-config.sh from OLLAMA_REMOTE_* variables in your .env.
# proxy/olla.yaml is generated locally and should never be committed.
#
# To add LAN Ollama nodes, set OLLAMA_REMOTE_* variables in your .env:
#
#   OLLAMA_REMOTE_1_NAME="workstation"
#   OLLAMA_REMOTE_1_URL="http://192.168.1.50:11434"
#   OLLAMA_REMOTE_1_PRIORITY="75"
#   OLLAMA_REMOTE_2_NAME="nas"
#   OLLAMA_REMOTE_2_URL="http://192.168.1.51:11434"
#   OLLAMA_REMOTE_2_PRIORITY="60"
#
# Then run:  ./scripts/generate-olla-config.sh
#
# ─────────────────────────────────────────────────────────────────────────────
# If you want to run Olla directly without the generator, you can copy this file:
#   cp scripts/olla.yaml.template proxy/olla.yaml
# and manually add your endpoint blocks below. Just don't commit that file.
# ─────────────────────────────────────────────────────────────────────────────

server:
  host: "0.0.0.0"
  port: 40114
  request_logging: true
  write_timeout: 600s

proxy:
  engine: "sherpa"
  load_balancer: "least-connections"
  response_timeout: 600s
  connection_timeout: 30s

discovery:
  type: "static"
  static:
    endpoints:

      # Local Intel Arc node — always present
      - url: "http://ollama-arc:11434"
        name: "ollama-arc-local"
        type: "ollama"
        priority: 100
        check_interval: 15s
        check_timeout: 5s

      # Additional LAN nodes are injected here by generate-olla-config.sh

      # Cloud gateway via LiteLLM
      - url: "http://litellm:4000"
        name: "litellm-cloud"
        type: "litellm"
        priority: 50
        check_interval: 30s
        check_timeout: 10s

  model_discovery:
    enabled: true
    interval: 5m

logging:
  level: "info"
  format: "text"
